# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
malachimq-*.tar

# Temporary files, for example, from tests.
/tmp/

# TLS certificates (generated for development)
/priv/cert/*.pem

# Environment files
.env
.env.local
.env.*.local

# IDE and editor files
.idea/
*.swp
*.swo
*~
.vscode/
*.sublime-project
*.sublime-workspace

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Node.js (for scripts/)
node_modules/
scripts/node_modules/
package-lock.json
scripts/package-lock.json

# Release artifacts (keep rel/ for vm.args.eex template, built releases go in /_build/)

# Dialyzer PLT files
/priv/plts/
*.plt
*.plt.hash

# Coverage reports
/excoveralls.json

# Benchmark results (except baseline_reference.json)
/benchmark/results/*
!/benchmark/results/baseline_reference.json
!/benchmark/results/.gitkeep

# Mnesia schema files generated by benchmarks
/benchmark/mnesia_data/

# Security tool outputs
sobelow-results.json
trivy-results.sarif
trivy-docker-results.sarif
.sobelow-skips

# Lefthook - keep lefthook.yml but ignore local state
lefthook-local.yml
.lefthook/
