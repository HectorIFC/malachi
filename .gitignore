# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Result pages rendered by `mix malachi.docs.results` from benchmark/published. Build output, not
# source: committing them would create two places a number lives and one of them would go stale.
/docs/generated/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
malachi-*.tar

# Temporary files, for example, from tests.
/tmp/

# TLS certificates (generated for development)
/priv/cert/*.pem
# Inter-node TLS dev certs (CA + node key/cert + optfile), never commit private keys
/priv/dist_cert/

# Environment files
.env
.env.local
.env.*.local

# IDE and editor files
.idea/
*.swp
*.swo
*~
.vscode/
*.sublime-project
*.sublime-workspace

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Node.js (for scripts/)
node_modules/
scripts/node_modules/
package-lock.json
scripts/package-lock.json

# Release artifacts (keep rel/ for vm.args.eex template, built releases go in /_build/)

# Dialyzer PLT files
/priv/plts/
*.plt
*.plt.hash

# Coverage reports
/excoveralls.json

# Benchmark results (keep the directory, ignore its contents)
/benchmark/results/*
!/benchmark/results/.gitkeep

# Security tool outputs
sobelow-results.json
trivy-results.sarif
trivy-docker-results.sarif
.sobelow-skips

# Lefthook - keep lefthook.yml but ignore local state
lefthook-local.yml
.lefthook/

# Plain-text files, documents and media (e.g. study notes, transcripts, source material)
*.txt
*.pdf
*.mp4

# Concuerror checkout and escript (built on demand by scripts/concuerror-setup.sh, not a dep)
/.concuerror/
