#!/bin/sh
# Malachi release env hook (sourced by bin/malachi at start).
#
# Inter-node TLS for Erlang distribution (opt-in). With MALACHIMQ_DIST_TLS=true the distribution protocol
# runs over TLS instead of plaintext: each node presents a certificate signed by the shared CA and verifies
# its peers (mutual TLS), configured by the ssl_dist options file at MALACHIMQ_DIST_TLS_OPTFILE (see
# rel/dist_tls.conf.example). Absent => plaintext distribution (the default; the cookie is the only guard).
#
# Fail fast on a misconfiguration rather than silently starting in plaintext when TLS was asked for.
if [ "$MALACHIMQ_DIST_TLS" = "true" ]; then
  if [ -z "$MALACHIMQ_DIST_TLS_OPTFILE" ]; then
    echo "malachi: MALACHIMQ_DIST_TLS=true but MALACHIMQ_DIST_TLS_OPTFILE is not set" >&2
    exit 1
  fi
  if [ ! -r "$MALACHIMQ_DIST_TLS_OPTFILE" ]; then
    echo "malachi: MALACHIMQ_DIST_TLS_OPTFILE ($MALACHIMQ_DIST_TLS_OPTFILE) is not readable" >&2
    exit 1
  fi
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -proto_dist inet_tls -ssl_dist_optfile ${MALACHIMQ_DIST_TLS_OPTFILE}"
fi
